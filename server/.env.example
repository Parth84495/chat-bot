# Optional: enables Gemini embeddings and grounded natural language answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: comma-separated frontend origins. Defaults to * for local development.
CORS_ORIGINS=*

# Optional: Neon/PostgreSQL connection string. When set, this takes priority over SQLite.
# Copy the pooled connection string from Neon and keep the real value only in server/.env.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local fallback when DATABASE_URL is empty.
# PDF_CHAT_DB=
